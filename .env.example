# World Air Quality Index (WAQI) API Token
# Acquire token at: https://aqicn.org/data-platform/token/
# Set this variable in your local environment or in a local .env file (do NOT commit .env):
WAQI_API_TOKEN=your_waqi_api_token_here

# Citizen Photo Reports Moderation Secret (Phase 5 f3)
# Secret bearer token used to authenticate moderator operations (/api/reports/moderation/*)
# Keep strictly secret on the server runtime. NEVER expose as VITE_*
CITIZEN_REPORTS_MODERATOR_TOKEN=replace_with_strong_random_moderator_secret_key

# Local upload directory override (optional, defaults to src/data/uploads)
CITIZEN_REPORTS_UPLOAD_DIR=src/data/uploads

# Production Database URL (PostgreSQL)
# Used by production backend to connect to PostgreSQL with citizen_reports schema
DATABASE_URL=postgresql://postgres:password@localhost:5432/vayudrishti?schema=public

# Reverse Proxy Trust Configuration (Abuse & Rate Limiting)
# Set to 'true' only when running behind a trusted reverse proxy (e.g. Nginx, Cloudflare, ALB)
# When 'false' or unset, rate limiting uses direct socket remoteAddress to prevent spoofing
TRUST_PROXY=false

# Rejected Report Retention (Days)
# Number of days to retain rejected reports before automated cleanup prunes database records and files
REJECTED_REPORT_RETENTION_DAYS=7

# Test Database URL (Strictly required for automated tests; must end in _test)
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/vayudrishti_test?schema=public

# ------------------------------------------------------------------------------
# Alert Delivery to Authorities (Phase 5 f4)
# ------------------------------------------------------------------------------
# Operating mode: 'dry_run' (default) logs outbox/audit rows without network transmission;
# 'live' performs authenticated external webhook dispatch and SMTP email delivery.
ALERT_DELIVERY_MODE=dry_run

# Minimum risk tier triggering authority delivery: WATCH (p>=0.05), ELEVATED (p>=0.22, default), or HIGH (p>=0.50)
ALERT_MIN_TIER=ELEVATED

# Token for managing authority recipients and outbox administration (/api/alerts/delivery/admin/*)
ALERT_ADMIN_TOKEN=replace_with_strong_random_alert_admin_token

# HMAC-SHA256 signature secret for outgoing webhook deliveries (X-VayuDrishti-Signature)
ALERT_WEBHOOK_SIGNING_SECRET=replace_with_strong_hmac_signing_secret

# SSRF Protection: Set to true ONLY in local dev/testing to permit loopback (localhost/127.0.0.1) webhooks.
# MUST be false or unset in production.
ALERT_ALLOW_PRIVATE_WEBHOOKS=false

# Per-station re-notification cooldown in hours (default: 6). Higher risk tier escalation bypasses cooldown.
ALERT_COOLDOWN_HOURS=6

# Maximum age of alert source observation before expiring outbox row (default: 6 hours)
ALERT_MAX_AGE_HOURS=6

# Outbox retry maximum attempts before marking row DEAD (default: 5)
ALERT_MAX_ATTEMPTS=5

# Outbox claim lease duration in seconds before stuck SENDING rows are reclaimed (default: 120)
ALERT_SEND_LEASE_SECONDS=120

# Admin token brute-force protection: failed attempts threshold within window (default: 10 failures / 600s)
ADMIN_AUTH_FAIL_LIMIT=10
ADMIN_AUTH_WINDOW_SECONDS=600

# Public-facing dashboard base URL included in alert payloads
DASHBOARD_BASE_URL=http://localhost:5173

# SMTP Configuration for Authority Email Delivery
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.org
SMTP_PASS=replace_with_smtp_password
ALERT_FROM_ADDRESS="VayuDrishti Early Warning <alerts@vayudrishti.org>"

# ------------------------------------------------------------------------------
# AI-Assisted Citizen Report Triage (Phase 5 f3b)
# ------------------------------------------------------------------------------
# Enable or disable automated advisory triage suggestion queue
TRIAGE_ENABLED=true

# Minimum confidence required to flag a category mismatch (0.0 to 1.0)
TRIAGE_MISMATCH_MIN_CONFIDENCE=0.60

# Confidence threshold below which the model suggestion is classified as uncertain (0.0 to 1.0)
TRIAGE_UNCERTAIN_BELOW=0.40

# Local directory where ONNX model weights and tokenizer files are cached (git-ignored)
TRIAGE_MODEL_CACHE_DIR=.model_cache/transformers

# Maximum time in milliseconds allowed per image classification before worker timeout
TRIAGE_TIMEOUT_MS=15000
